{
  "manifest_version": 3,
  "name": "Life OS Companion",
  "version": "1.0.0",
  "description": "Counts time on the active tab and saves the YouTube videos you watch, then shares it with your Life OS. Data stays on your computer.",
  "permissions": ["tabs", "storage", "idle", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Life OS Companion", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "file:///*", "https://*.github.io/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
